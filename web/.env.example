# Server-only values. Configure in Vercel project settings, never in client JS.
APP_ORIGIN=https://your-recent-saves.vercel.app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# UUID of the sole permitted Supabase Auth user (create this user first).
ALLOWED_USER_ID=
# Optional; enables Reader refresh, moves and deletion.
READER_TOKEN=
# Optional; Raindrop controls show unavailable until configured.
RAINDROP_TOKEN=
